import Moist.MIR.Optimize.Advanced.Traversal
import Moist.MIR.Optimize.Advanced.Results

namespace Moist.MIR.Advanced

/-! Facts describe the shape of a value after successful evaluation, not the
totality of its producer. Only dominating bindings provide facts. Dead-binding
decisions use the prefix environment, preserving the validation establishing a
fact. Public scope-moving entry points establish unique lexical binders and
skip the rewrite when the freshened program is not well scoped. Checked
conversion round trips retain their validating producers. Arithmetic
identities require runtime Integer evidence and retain effects of discarded
operands. Boolean branch facts are confined to the selected alternative.
Binders generated by the walks lie above every identifier of the walked
program, so they never capture a name that a recorded fact mentions.
-/

open Moist.Plutus.Term

def knownBooleanLocal : Nat → List (VarId × Expr) → Expr → Bool
  | 0, _, _ => false
  | fuel + 1, environment, expression =>
    match expression with
    | .Lit (.Bool _, _) => true
    | .Var binder =>
      (environment.find? (fun entry => entry.1 == binder)).any
        (fun entry => knownBooleanLocal fuel environment entry.2)
    | .App function _ =>
      let head := resolveHead fuel environment function
      (builtinProtocolAfterSuccess head).any fun (builtin, remaining) =>
        remaining.head == .argV && remaining.isFinal && booleanBuiltin builtin
    | .Case _ alternatives =>
      !alternatives.isEmpty && alternatives.all (knownBooleanLocal fuel environment)
    | _ => false

def knownBoolean (fuel : Nat) (environment : List (VarId × Expr)) (expression : Expr) : Bool :=
  knownBooleanLocal fuel environment expression || knownBooleanResult fuel environment expression

def constructorPair : Nat → List (VarId × Expr) → Expr → Bool
  | 0, _, _ => false
  | fuel + 1, environment, expression =>
    match expression with
    | .Var binder =>
      (environment.find? (fun entry => entry.1 == binder)).any
        (fun entry => constructorPair fuel environment entry.2)
    | .App function _ =>
      match resolveHead fuel environment function with
      | .Builtin .UnConstrData => true
      | _ => false
    | _ => false

def knownList : Nat → List (VarId × Expr) → Expr → Bool
  | 0, _, _ => false
  | fuel + 1, environment, expression =>
    match expression with
    | .Var binder =>
      (environment.find? (fun entry => entry.1 == binder)).any
        (fun entry => knownList fuel environment entry.2)
    | .Lit (.ConstList _, .TypeOperator (.TypeList _))
    | .Lit (.ConstDataList _, .TypeOperator (.TypeList _))
    | .Lit (.ConstPairDataList _, .TypeOperator (.TypeList _)) => true
    | .App function argument =>
      match resolveHead fuel environment function with
      | .Builtin .UnListData | .Force (.Builtin .TailList) => true
      | .Force (.Force (.Builtin .SndPair)) => constructorPair fuel environment argument
      | _ => false
    | _ => false

/-! ## Termination measures -/

theorem exprSize_pos (expression : Expr) : 0 < exprSize expression := by
  cases expression <;> simp [exprSize] <;> omega

theorem exprSizeBinds_append (left right : List (VarId × Expr × Bool)) :
    exprSizeBinds (left ++ right) = exprSizeBinds left + exprSizeBinds right := by
  induction left with
  | nil => simp [exprSizeBinds]
  | cons binding rest inductionHypothesis =>
    obtain ⟨binder, rhs, erased⟩ := binding
    simp only [List.cons_append, exprSizeBinds, inductionHypothesis]
    omega

theorem exprSize_flattenBindings (bindings : List (VarId × Expr × Bool)) (body : Expr) :
    exprSizeBinds (flattenBindings bindings body).1 + exprSize (flattenBindings bindings body).2 ≤
      exprSizeBinds bindings + exprSize body := by
  match body with
  | .Let more suffix =>
    rw [flattenBindings]
    have bound := exprSize_flattenBindings (bindings ++ more) suffix
    rw [exprSizeBinds_append] at bound
    simp only [exprSize]
    omega
  | .Var _ | .Lit _ | .Builtin _ | .Error | .Lam _ _ | .Fix _ _ | .App _ _ | .Force _
  | .Delay _ | .Constr _ _ | .Case _ _ => simp [flattenBindings]
termination_by exprSize body
decreasing_by simp [exprSize]; omega

theorem exprSize_lt_of_mem {child : Expr} {children : List Expr} (member : child ∈ children) :
    exprSize child < exprSizeList children + 1 := by
  induction children with
  | nil => cases member
  | cons head tail inductionHypothesis =>
    simp only [List.mem_cons] at member
    cases member with
    | inl equal => subst equal; simp [exprSizeList]; omega
    | inr member => have bound := inductionHypothesis member; simp only [exprSizeList]; omega

theorem exprSizeBinds_mem_lt {binding : VarId × Expr × Bool} {bindings : List (VarId × Expr × Bool)}
    (member : binding ∈ bindings) : exprSize binding.2.1 < exprSizeBinds bindings + 1 := by
  induction bindings with
  | nil => cases member
  | cons head tail inductionHypothesis =>
    obtain ⟨binder, rhs, erased⟩ := head
    simp only [List.mem_cons] at member
    cases member with
    | inl equal => subst equal; simp [exprSizeBinds]; omega
    | inr member => have bound := inductionHypothesis member; simp only [exprSizeBinds]; omega

/-! ## List destructor fusion -/

set_option linter.unusedVariables false in
def fuseListWalk (environment : List (VarId × Expr)) (expression : Expr) : Expr :=
  match expression with
  | .Let bindings body =>
    match flattening : flattenBindings bindings body with
    | ((headBinder, headRhs, headErased) :: (tailBinder, tailRhs, tailErased) :: remaining, inner) =>
      match resolveHead 64 environment headRhs, resolveHead 64 environment tailRhs with
      | .App (.Force (.Builtin .HeadList)) (.Var listBinder),
        .App (.Force (.Builtin .TailList)) (.Var other) =>
        if listBinder == other && knownList 64 environment (.Var listBinder) then
          .Case (.Var listBinder) [.Lam headBinder (.Lam tailBinder
            (fuseListWalk ((tailBinder, tailRhs) :: (headBinder, headRhs) :: environment)
              (.Let remaining inner))), .Error]
        else
          .Let [(headBinder, fuseListWalk environment headRhs, headErased)]
            (fuseListWalk ((headBinder, headRhs) :: environment)
              (.Let ((tailBinder, tailRhs, tailErased) :: remaining) inner))
      | _, _ =>
        .Let [(headBinder, fuseListWalk environment headRhs, headErased)]
          (fuseListWalk ((headBinder, headRhs) :: environment)
            (.Let ((tailBinder, tailRhs, tailErased) :: remaining) inner))
    | ([(binder, rhs, erased)], inner) =>
      .Let [(binder, fuseListWalk environment rhs, erased)]
        (fuseListWalk ((binder, rhs) :: environment) inner)
    | ([], inner) => fuseListWalk environment inner
  | .Lam binder body => .Lam binder (fuseListWalk environment body)
  | .Fix binder body => .Fix binder (fuseListWalk environment body)
  | .App function argument => .App (fuseListWalk environment function) (fuseListWalk environment argument)
  | .Force body => .Force (fuseListWalk environment body)
  | .Delay body => .Delay (fuseListWalk environment body)
  | .Constr tag fields => .Constr tag (fields.attach.map fun ⟨field, _⟩ => fuseListWalk environment field)
  | .Case scrutinee alternatives =>
    .Case (fuseListWalk environment scrutinee)
      (alternatives.attach.map fun ⟨alternative, _⟩ => fuseListWalk environment alternative)
  | .Var _ | .Lit _ | .Builtin _ | .Error => expression
termination_by exprSize expression
decreasing_by
  all_goals first
    | (have bound := exprSize_flattenBindings bindings body
       rw [flattening] at bound
       simp only [exprSize, exprSizeBinds] at bound ⊢
       have := exprSize_pos headRhs
       have := exprSize_pos tailRhs
       omega)
    | (have bound := exprSize_flattenBindings bindings body
       rw [flattening] at bound
       simp only [exprSize, exprSizeBinds] at bound ⊢
       omega)
    | (simp only [exprSize]; omega)
    | (have := exprSize_lt_of_mem (by assumption); simp only [exprSize]; omega)

def fuseListDestructors (expression : Expr) : Expr :=
  let unique := uniqueOptimizationBinders expression
  if wellScoped unique then fuseListWalk [] unique else unique

/-! ## List choice fusion -/

def replaceListProjections (listBinder headBinder tailBinder : VarId)
    (expression : Expr) : Expr :=
  match expression with
  | .App (.Force (.Builtin .HeadList)) (.Var binder) =>
    if binder == listBinder then .Var headBinder else expression
  | .App (.Force (.Builtin .TailList)) (.Var binder) =>
    if binder == listBinder then .Var tailBinder else expression
  | .App function argument =>
    .App (replaceListProjections listBinder headBinder tailBinder function)
      (replaceListProjections listBinder headBinder tailBinder argument)
  | .Lam binder body => .Lam binder (replaceListProjections listBinder headBinder tailBinder body)
  | .Fix binder body => .Fix binder (replaceListProjections listBinder headBinder tailBinder body)
  | .Force body => .Force (replaceListProjections listBinder headBinder tailBinder body)
  | .Delay body => .Delay (replaceListProjections listBinder headBinder tailBinder body)
  | .Constr tag fields =>
    .Constr tag (fields.attach.map fun ⟨field, _⟩ =>
      replaceListProjections listBinder headBinder tailBinder field)
  | .Case scrutinee alternatives =>
    .Case (replaceListProjections listBinder headBinder tailBinder scrutinee)
      (alternatives.attach.map fun ⟨alternative, _⟩ =>
        replaceListProjections listBinder headBinder tailBinder alternative)
  | .Let bindings body =>
    .Let (bindings.attach.map fun ⟨(binder, rhs, erased), _⟩ =>
        (binder, replaceListProjections listBinder headBinder tailBinder rhs, erased))
      (replaceListProjections listBinder headBinder tailBinder body)
  | .Var _ | .Lit _ | .Builtin _ | .Error => expression
termination_by exprSize expression
decreasing_by
  all_goals first
    | (simp only [exprSize]; omega)
    | (have := exprSize_lt_of_mem (by assumption); simp only [exprSize]; omega)
    | (have := exprSizeBinds_mem_lt (by assumption)
       simp only [exprSize] at *; omega)

def listChoiceRewrite (base : Nat) (environment : List (VarId × Expr)) (result : Expr) : Expr :=
  match result with
  | .Case (.App function (.Var listBinder)) [nonempty, empty] =>
    if resolveHead 64 environment function == .Force (.Builtin .NullList) &&
        knownList 64 environment (.Var listBinder) then
      let headBinder : VarId :=
        { uid := max base (maxUidExpr result + 1), origin := .gen, hint := "head" }
      let tailBinder : VarId :=
        { uid := max base (maxUidExpr result + 1) + 1, origin := .gen, hint := "tail" }
      .Case (.Var listBinder)
        [.Lam headBinder (.Lam tailBinder (replaceListProjections listBinder headBinder tailBinder nonempty)), empty]
    else result
  | _ => result

def listChoiceWalk (base : Nat) (environment : List (VarId × Expr)) (expression : Expr) : Expr :=
  match expression with
  | .Let [] body => listChoiceWalk base environment body
  | .Let ((binder, rhs, erased) :: rest) body =>
    let rhs' := listChoiceWalk base environment rhs
    .Let [(binder, rhs', erased)] (listChoiceWalk base ((binder, rhs') :: environment) (.Let rest body))
  | .Lam binder body => listChoiceRewrite base environment (.Lam binder (listChoiceWalk base environment body))
  | .Fix binder body => listChoiceRewrite base environment (.Fix binder (listChoiceWalk base environment body))
  | .App function argument =>
    listChoiceRewrite base environment
      (.App (listChoiceWalk base environment function) (listChoiceWalk base environment argument))
  | .Force body => listChoiceRewrite base environment (.Force (listChoiceWalk base environment body))
  | .Delay body => listChoiceRewrite base environment (.Delay (listChoiceWalk base environment body))
  | .Constr tag fields =>
    listChoiceRewrite base environment
      (.Constr tag (fields.attach.map fun ⟨field, _⟩ => listChoiceWalk base environment field))
  | .Case scrutinee alternatives =>
    listChoiceRewrite base environment
      (.Case (listChoiceWalk base environment scrutinee)
        (alternatives.attach.map fun ⟨alternative, _⟩ => listChoiceWalk base environment alternative))
  | .Var _ | .Lit _ | .Builtin _ | .Error => listChoiceRewrite base environment expression
termination_by exprSize expression
decreasing_by
  all_goals first
    | (simp only [exprSize, exprSizeBinds]; omega)
    | (simp only [exprSize, exprSizeBinds]; have := exprSize_pos rhs; omega)
    | (have := exprSize_lt_of_mem (by assumption); simp only [exprSize]; omega)

def fuseListChoices (expression : Expr) : Expr :=
  let unique := uniqueOptimizationBinders expression
  if wellScoped unique then
    uniqueOptimizationBinders (listChoiceWalk (maxUidExpr unique + 1) [] unique)
  else unique

/-! ## Checked shape simplification -/

def knownInteger : Nat → List (VarId × Expr) → Expr → Bool
  | 0, _, _ => false
  | fuel + 1, environment, expression =>
    match expression with
    | .Lit (.Integer _, _) => true
    | .Var binder =>
      (environment.find? (fun entry => entry.1 == binder)).any
        (fun entry => knownInteger fuel environment entry.2)
    | .App function argument =>
      let head := resolveHead fuel environment function
      match head with
      | .Force (.Force (.Builtin .FstPair)) => constructorPair fuel environment argument
      | _ =>
        (builtinProtocolAfterSuccess head).any fun (builtin, remaining) =>
          remaining.head == .argV && remaining.isFinal &&
          match builtin with
          | .AddInteger | .SubtractInteger | .MultiplyInteger | .DivideInteger
          | .QuotientInteger | .RemainderInteger | .ModInteger | .UnIData
          | .LengthOfByteString | .IndexByteString => true
          | _ => false
    | _ => false

def totalWithFacts : Nat → List (VarId × Expr) → Expr → Bool
  | 0, _, expression => isPure expression
  | fuel + 1, environment, expression =>
    isPure expression ||
      match expression with
      | .App function argument =>
        match resolveHead 64 environment function with
        | .App (.Builtin builtin) first =>
          let integerOperation := match builtin with
            | .AddInteger | .SubtractInteger | .MultiplyInteger | .EqualsInteger
            | .LessThanInteger | .LessThanEqualsInteger => true
            | _ => false
          integerOperation && knownInteger 64 environment first && knownInteger 64 environment argument &&
            totalWithFacts fuel environment first && totalWithFacts fuel environment argument
        | .Force (.Force (.Builtin builtin)) =>
          (builtin == .FstPair || builtin == .SndPair) && constructorPair 64 environment argument &&
            totalWithFacts fuel environment argument
        | _ => false
      | _ => false

def delayBody : Expr → Option Expr
  | .Delay body => some body
  | _ => none

def checkedRoundTrip (environment : List (VarId × Expr)) : Expr → Option Expr
  | .App (.Builtin outer) (.Var checked) =>
    match resolveHead 64 environment (.Var checked) with
    | .App (.Builtin inner) (.Var original) =>
      let inverse := match outer, inner with
        | .IData, .UnIData | .UnIData, .IData
        | .BData, .UnBData | .UnBData, .BData
        | .ListData, .UnListData | .MapData, .UnMapData => true
        | _, _ => false
      if inverse then some (.Var original) else none
    | _ => none
  | _ => none

def integerConstant (value : Int) : Expr :=
  .Lit (.Integer value, .AtomicType .TypeInteger)

def isIntegerLiteral (expression : Expr) (value : Int) : Bool :=
  match expression with
  | .Lit (.Integer actual, .AtomicType .TypeInteger) => actual == value
  | _ => false

def retainEvaluation (base : Nat) (environment : List (VarId × Expr))
    (expression result : Expr) : Expr :=
  if totalWithFacts 64 environment expression then result
  else
    let unused : VarId := {
      uid := max base (max (maxUidExpr expression) (maxUidExpr result) + 1)
      origin := .gen
      hint := "evaluated" }
    .Let [(unused, expression, false)] result

def integerIdentity (base : Nat) (environment : List (VarId × Expr)) : Expr → Option Expr
  | .App (.App (.Builtin builtin) first) second => do
    if !knownInteger 64 environment first || !knownInteger 64 environment second then none
    else
      match builtin with
      | .AddInteger =>
        if isIntegerLiteral first 0 then some second
        else if isIntegerLiteral second 0 then some first else none
      | .SubtractInteger =>
        if isIntegerLiteral second 0 then some first
        else match first, second with
          | .Var left, .Var right => if left == right then some (integerConstant 0) else none
          | _, _ => none
      | .MultiplyInteger =>
        if isIntegerLiteral first 1 then some second
        else if isIntegerLiteral second 1 then some first
        else if isIntegerLiteral first 0 then
          some (retainEvaluation base environment second (integerConstant 0))
        else if isIntegerLiteral second 0 then
          some (retainEvaluation base environment first (integerConstant 0))
        else none
      | .DivideInteger | .QuotientInteger =>
        if isIntegerLiteral second 1 then some first else none
      | .RemainderInteger | .ModInteger =>
        if isIntegerLiteral second 1 then
          some (retainEvaluation base environment first (integerConstant 0))
        else none
      | .EqualsInteger | .LessThanInteger | .LessThanEqualsInteger =>
        match first, second with
        | .Var left, .Var right =>
          if left == right then
            some (.Lit (.Bool (builtin != .LessThanInteger), .AtomicType .TypeBool))
          else none
        | _, _ => none
      | _ => none
  | _ => none

/-- Local rewrites applied after the children of a node are simplified. -/
def shapeRewrite (useShapes : Bool) (base : Nat) (environment : List (VarId × Expr))
    (result : Expr) : Expr :=
  let result := if useShapes then
    (checkedRoundTrip environment result).getD result else result
  let result := if useShapes then
    (integerIdentity base environment result).getD result else result
  match result with
  | .App (.App (.App (.Force (.Builtin .IfThenElse)) condition) whenTrue) whenFalse =>
    if knownBoolean 64 environment condition && isPure whenTrue && isPure whenFalse then
      .Case condition [whenFalse, whenTrue]
    else result
  | .Force (.Case scrutinee alternatives) =>
    if knownBoolean 64 environment scrutinee then
      match alternatives.mapM delayBody with
      | some bodies => .Case scrutinee bodies
      | none => result
    else result
  | .Case scrutinee [first, second] =>
    if useShapes && alphaEq first second && knownBoolean 64 environment scrutinee then
      if totalWithFacts 64 environment scrutinee then first
      else
        let unused : VarId :=
          { uid := max base (maxUidExpr result + 1), origin := .gen, hint := "checked" }
        .Let [(unused, scrutinee, false)] first
    else result
  | _ => result

/-- Drop the bindings whose evaluation is known total and whose binder is unused
    by the remaining bindings and the body. -/
def retainBindings (body : Expr) :
    List ((VarId × Expr × Bool) × Bool) → List (VarId × Expr × Bool)
  | [] => []
  | (binding, total) :: rest =>
    let suffix := retainBindings body rest
    if total && !(freeVars (.Let suffix body)).contains binding.1 then suffix
    else binding :: suffix

mutual
  def simplifyWalk (useShapes : Bool) (base : Nat) (environment : List (VarId × Expr))
      (expression : Expr) : Expr :=
    match expression with
    | .Case (.Var binder) [first, second] =>
      if useShapes && knownBoolean 64 environment (.Var binder) then
        match resolveHead 64 environment (.Var binder) with
        | .Lit (.Bool value, .AtomicType .TypeBool) =>
          if value then simplifyWalk useShapes base environment second
          else simplifyWalk useShapes base environment first
        | _ =>
          let first' := simplifyWalk useShapes base
            ((binder, .Lit (.Bool false, .AtomicType .TypeBool)) :: environment) first
          let second' := simplifyWalk useShapes base
            ((binder, .Lit (.Bool true, .AtomicType .TypeBool)) :: environment) second
          if alphaEq first' second' then first' else .Case (.Var binder) [first', second']
      else
        .Case (.Var binder) [simplifyWalk useShapes base environment first,
          simplifyWalk useShapes base environment second]
    | .Let bindings body =>
      let processed := simplifyBindings useShapes base environment bindings
      let body' := simplifyWalk useShapes base processed.2 body
      let retained := retainBindings body' processed.1
      if retained.isEmpty then body' else .Let retained body'
    | .Lam binder body => .Lam binder (simplifyWalk useShapes base environment body)
    | .Fix binder body => .Fix binder (simplifyWalk useShapes base environment body)
    | .App function argument =>
      shapeRewrite useShapes base environment
        (.App (simplifyWalk useShapes base environment function)
          (simplifyWalk useShapes base environment argument))
    | .Force body => shapeRewrite useShapes base environment (.Force (simplifyWalk useShapes base environment body))
    | .Delay body => shapeRewrite useShapes base environment (.Delay (simplifyWalk useShapes base environment body))
    | .Constr tag fields =>
      shapeRewrite useShapes base environment
        (.Constr tag (fields.attach.map fun ⟨field, _⟩ => simplifyWalk useShapes base environment field))
    | .Case scrutinee alternatives =>
      shapeRewrite useShapes base environment
        (.Case (simplifyWalk useShapes base environment scrutinee)
          (alternatives.attach.map fun ⟨alternative, _⟩ =>
            simplifyWalk useShapes base environment alternative))
    | .Var _ | .Lit _ | .Builtin _ | .Error => shapeRewrite useShapes base environment expression
  termination_by exprSize expression
  decreasing_by
    all_goals first
      | (simp only [exprSize, exprSizeList]; omega)
      | (simp only [exprSize]; have := exprSize_pos body; omega)
      | (have := exprSize_lt_of_mem (by assumption); simp only [exprSize]; omega)

  def simplifyBindings (useShapes : Bool) (base : Nat) (available : List (VarId × Expr)) :
      List (VarId × Expr × Bool) → List ((VarId × Expr × Bool) × Bool) × List (VarId × Expr)
    | [] => ([], available)
    | (binder, rhs, erased) :: rest =>
      let rhs' := simplifyWalk useShapes base available rhs
      let total := useShapes && totalWithFacts 64 available rhs'
      let processed := simplifyBindings useShapes base ((binder, rhs') :: available) rest
      (((binder, rhs', erased), total) :: processed.1, processed.2)
  termination_by bindings => exprSizeBinds bindings + 1
  decreasing_by
    all_goals first
      | (simp only [exprSizeBinds]; omega)
      | (simp only [exprSizeBinds]; have := exprSize_pos rhs; omega)
end

def simplifyWithFacts (useShapes : Bool) (expression : Expr) : Expr :=
  let unique := uniqueOptimizationBinders expression
  if wellScoped unique then
    uniqueOptimizationBinders (simplifyWalk useShapes (maxUidExpr unique + 1) [] unique)
  else unique

def simplifyChoices (expression : Expr) : Expr := simplifyWithFacts false expression

def shapeDCE (expression : Expr) : Expr := simplifyWithFacts true expression

end Moist.MIR.Advanced
