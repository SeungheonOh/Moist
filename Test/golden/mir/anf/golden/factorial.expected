@ output
let fac_10 =
  fix fac_10 =
    λn_11.
      let ganf_15 = equalsInteger n_11
      let isZero_12 = ganf_15 0
      let ganf_16 = ifThenElse isZero_12
      let ganf_17 = delay 1
      let ganf_20 = ganf_16 ganf_17
      let ganf_21 =
        delay
          let ganf_18 = subtractInteger n_11
          let n1_13 = ganf_18 1
          let facN1_14 = fac_10 n1_13
          let ganf_19 = multiplyInteger n_11
          in ganf_19 facN1_14
      let ganf_22 = ganf_20 ganf_21
      in force ganf_22
in fac_10 10

@ isANF
true
